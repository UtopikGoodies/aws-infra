region = "ca-central-1"

# Set to true only for a brand-new management account with no organization yet.
create_organization = false

default_tags = {
  managed_by = "terraform"
  workload   = "platform"
}

# Account emails are auto-generated as aws+<account>@<domain> when per-account email is not set.
account_email_domain = "example.com"

organizational_units = {
  security = {
    name = "Security"
  }

  shared = {
    name = "Shared Services"
  }

  prod = {
    name = "Production"
  }

  nonprod = {
    name = "NonProduction"
  }

  sandbox = {
    name          = "Sandbox"
    parent_ou_key = "nonprod"
  }
}

accounts = {
  log_archive = {
    name          = "LogArchive"
    parent_ou_key = "security"
    tags = {
      environment = "security"
    }
  }

  audit = {
    name          = "Audit"
    parent_ou_key = "security"
  }

  # Sensitive service accounts - separate for security (defense-in-depth)
  # All under "shared" OU for easy policy management
  
  networking = {
    email_local_part = "networking"
    name          = "Networking"
    parent_ou_key = "shared"
    tags = {
      account_type = "shared"
      service      = "networking"
    }
  }

  logging = {
    email_local_part = "logging"
    name          = "Logging"
    parent_ou_key = "shared"
    tags = {
      account_type = "shared"
      service      = "logging"
    }
  }

  security_services = {
    email_local_part = "security-services"
    name          = "Security Services"
    parent_ou_key = "shared"
    tags = {
      account_type = "shared"
      service      = "security"
    }
  }

#   containers = {
#     name             = "Containers"
#     email_local_part = "containers"
#     parent_ou_key    = "shared"
#     tags = {
#       account_type = "shared"
#       service      = "containers"
#     }
#   }

  dns = {
    email_local_part = "dns"
    name          = "DNS"
    parent_ou_key = "shared"
    tags = {
      account_type = "shared"
      service      = "dns"
    }
  }
}

scp_policies = {
  deny_leave_org = {
    description = "Prevent member accounts from leaving the organization"
    content = jsonencode({
      Version = "2012-10-17"
      Statement = [
        {
          Sid      = "DenyLeaveOrganization"
          Effect   = "Deny"
          Action   = "organizations:LeaveOrganization"
          Resource = "*"
        }
      ]
    })
  }
}

policy_attachments = {
  deny_leave_org_to_root = {
    policy_key  = "deny_leave_org"
    target_type = "ROOT"
  }
}

delegated_administrators = {}
